SITE_URL=https://ipu.usestrict.dev
PORT=3000
HOST=0.0.0.0
MAXMIND_CITY_DB=assets/GeoLite2-City-2026-06-05.mmdb
MAXMIND_ASN_DB=assets/GeoLite2-ASN.mmdb
# Vercel build only: direct HTTPS .mmdb URLs (City required when absent; ASN optional).
MAXMIND_CITY_DB_URL=
MAXMIND_ASN_DB_URL=
# Only list proxies you control. They must append/overwrite X-Forwarded-For.
# Example for a local reverse proxy: 127.0.0.1/32,::1/128
TRUSTED_PROXIES=

# Optional Chrome WebMCP origin-trial token issued for your HTTPS origin.
WEBMCP_ORIGIN_TRIAL_TOKEN=
